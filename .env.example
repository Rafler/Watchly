TMDB_API_KEY=<your_tmdb_api_key>
REDIS_URL=redis://redis:6379/0
TOKEN_SALT=change-me # generate secure salt...

# app setup
APP_ENV="development"  # available values are ["development", "production"]
HOST_NAME=<your_addon_url>
PORT=8000
ALLOW_SIGNUPS=True  # False locks the instance to existing accounts

# redis
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECTIONS_THRESHOLD=100

# UPDATER
# Long-running servers rebuild every account on this interval. Vercel does not
# run that loop; set CRON_SECRET and use the /cron/resync schedule in vercel.json.
AUTO_UPDATE_CATALOGS=True
CATALOG_REFRESH_INTERVAL_SECONDS=86400 # once a day

# OpenRouter ranks and names Top Picks, Because you watched, and theme rows
# during that resync. Leave both unset to keep the built-in scores.
# Decision models (typesafe/jev-*) are missing from the default models list;
# they appear with output_modalities=all or output_modalities=decisions.
# Pin a versioned id. typesafe/jev-router is a text model, not a decision model.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=typesafe/jev-1.14

# Bearer secret for GET/POST /cron/resync. Unset, that endpoint returns 503.
# CRON_SECRET=

# Optional integrations
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=   # only for legacy (non-PKCE) Trakt apps
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=
